node_modules/
test-results/
playwright-report/
playwright/.auth/
.env
*.log
demo-app/shop.db
rwa-app/
rwa-app-ci/
# Claude Code: keep the shared project settings, ignore everything personal/generated
# (settings.local.json, installed skills/commands, caches). `.claude/*` rather than
# `.claude/` so the re-include below can work — git cannot un-ignore inside an ignored dir.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/agents/
!.claude/rules/
!.claude/hooks/

# Python (claude-agent demo)
__pycache__/
*.pyc

# PromptLens / SDLC observer — local-only artifacts
*.whl

# claude-config demo artefacts
claude-config/proxy_demo.log

# scratch dirs made by sessions/ demos
.scratch/

# ── Documentation policy ────────────────────────────────────────────────────
# Only the root README.md is tracked. Every other prose .md — session study
# notes, presenter scripts, per-area notes — stays local to each machine.
# (Functional Markdown is NOT prose and stays tracked: CLAUDE.md project
#  memory, and .claude/ + .agents/ skills, commands, agents and rules.)
# These rules were previously in .git/info/exclude, which does not travel with
# a clone — moved here so the policy applies to everyone who checks out.
sessions/**/*.md
docs/*.md
claude-config/*.md
