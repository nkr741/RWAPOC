{
  "name": "ryvan-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid + POM Playwright framework against Cypress Real World App — Ryvan Technologies",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:e2e": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:integration": "playwright test tests/integration --project=chromium",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:practice": "playwright test --project=practice",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:update-snapshots": "playwright test tests/practice/visual-regression.spec.ts --project=practice --update-snapshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "express": "^4.21.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
